/* Structure only: sizes, spacing, radii, border widths and type, and no images, which would
   bake a colour in. Every colour lives in reviaTheme.qss, which theme.cpp fills from the
   light or dark tokens and appends to this sheet. Under Windows high contrast this sheet is
   used with reviaContrast.qss instead, which takes its few colours from the system palette:
   borders declared here without a colour take the system text colour, and the sub-controls
   whose state is shown only by colour (check indicators, combo arrows, progress chunks, the
   selected tab's underline) are styled in reviaTheme.qss alone, leaving the native drawing
   in place here. So are spin boxes as a whole: given any box rule, Qt draws no arrows of its
   own. Revia.StudioPanels loads this file raw.
   Weights are 400 and 600 only. Spacing steps are 4, 8, 12, 16, 20, 24, 32 and 40; radii
   are 4 (badges), 6 (controls), 10 (cards), 14 (palette), 20 (composer) and pills. */

QWidget { font-size: 13px; }
QToolTip { border: 1px solid; padding: 6px 8px; font-size: 12px; }

/* ---------------------------------------------------------------- buttons */
/* One definition per control. A focused control trades 1px of padding for a 2px ring, so
   the layout does not move when focus arrives. */

QPushButton {
    border: 1px solid;
    border-radius: 6px;
    padding: 6px 14px;
    min-height: 18px;
    font-size: 13px;
    font-weight: 600;
}
QPushButton:focus { border-width: 2px; padding: 5px 13px; }
QPushButton::menu-indicator { image: none; width: 0px; }
QPushButton[flat="true"] { border-color: transparent; }

QToolButton {
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 6px;
}
QToolButton:focus { border-width: 2px; padding: 5px; }
QToolButton#sidebarMenuButton::menu-indicator, QToolButton#chatMoreButton::menu-indicator,
QToolButton#composerProfileChip::menu-indicator, QToolButton#sidebarRailPanels::menu-indicator {
    image: none;
    width: 0px;
}

/* Small secondary actions beside the text they act on. */
QPushButton#conversationDetailsButton, QPushButton#reviewAnswerButton, QPushButton#memoryReviseSelected,
QPushButton#voiceHealthDetailsButton, QPushButton#runtimeDetailsButton, QPushButton#statusPopoverActivity,
QPushButton#composerContextAction, QPushButton#settingsRestartLater, QPushButton#presenceOpenSettings {
    padding: 4px 10px;
    font-size: 12px;
}
QPushButton#conversationDetailsButton:focus, QPushButton#reviewAnswerButton:focus, QPushButton#memoryReviseSelected:focus,
QPushButton#voiceHealthDetailsButton:focus, QPushButton#runtimeDetailsButton:focus, QPushButton#statusPopoverActivity:focus,
QPushButton#composerContextAction:focus, QPushButton#settingsRestartLater:focus, QPushButton#presenceOpenSettings:focus {
    padding: 3px 9px;
}
QPushButton#attachButton, QPushButton#documentsButton { padding: 5px 10px; }
QPushButton#attachButton:focus, QPushButton#documentsButton:focus { padding: 4px 9px; }

/* ---------------------------------------------------------------- check boxes and radio buttons */

QCheckBox, QRadioButton { spacing: 8px; padding: 3px 0; }
QCheckBox[reviaRole="settingSwitch"] { spacing: 0px; padding: 0px; }

/* ---------------------------------------------------------------- inputs */

QLineEdit, QComboBox {
    border: 1px solid;
    border-radius: 6px;
    padding: 6px 8px;
    min-height: 18px;
    font-size: 13px;
}
QLineEdit:focus, QComboBox:focus {
    border-width: 2px;
    padding: 5px 7px;
}
QPlainTextEdit, QTextEdit, QTextBrowser {
    border: 1px solid;
    border-radius: 10px;
    padding: 8px;
    font-size: 13px;
}
QPlainTextEdit:focus, QTextEdit:focus { border-width: 2px; padding: 7px; }

QComboBox { padding-right: 28px; }
QComboBox:focus { padding-right: 27px; }
QComboBox QAbstractItemView { border: 1px solid; padding: 4px; outline: none; }

/* ---------------------------------------------------------------- lists, tables and trees */
/* Padding rather than a fixed height, so a row still grows with its own content. */

QTableWidget, QTreeWidget, QListWidget, QTableView, QTreeView, QListView {
    border: 1px solid;
    border-radius: 10px;
    padding: 1px;
    outline: none;
}
/* A click focuses an item view too, so its 2px ring shows only after keyboard focus (theme.cpp
   sets kbdFocus). The second pixel comes out of the padding, so the rows do not move; lists
   drawn without a border keep 2px of padding for the same reason. border-style and
   border-width rather than the shorthand, which would reset the ring's colour. */
QTableWidget[kbdFocus="true"]:focus, QTreeWidget[kbdFocus="true"]:focus, QListWidget[kbdFocus="true"]:focus,
QTableView[kbdFocus="true"]:focus, QTreeView[kbdFocus="true"]:focus, QListView[kbdFocus="true"]:focus {
    border-width: 2px;
    padding: 0px;
}
QTreeWidget::item, QTableWidget::item, QListWidget::item { padding: 7px 6px; }
QHeaderView::section {
    border: none;
    border-bottom: 1px solid;
    padding: 9px 10px;
    font-size: 12px;
    font-weight: 600;
}

/* ---------------------------------------------------------------- tabs */

QTabWidget::pane { border: none; }
QTabBar::tab {
    padding: 9px 13px;
    margin-right: 1px;
    font-size: 13px;
    font-weight: 600;
}
QTabBar#sectionNavigation::tab { padding: 7px 10px; font-size: 12px; }
QTabBar QToolButton { border: 1px solid; border-radius: 4px; min-width: 22px; }

/* ---------------------------------------------------------------- cards */
/* Settings-like pages, Presence, Vision, Voice and Profiles are built from QGroupBox, so
   restyling that one class as a card reaches all of them without touching a panel's
   layout code. The room above the frame holds the title; the inner padding keeps
   controls off the edge. */

QGroupBox {
    border: 1px solid;
    border-radius: 10px;
    margin-top: 24px;
    padding: 20px 18px 18px 18px;
    font-size: 14px;
    font-weight: 600;
}
QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left; left: 16px; padding: 0 8px; }

QProgressBar { border: 1px solid; border-radius: 6px; text-align: center; font-weight: 600; }

QMenu { border: 1px solid; padding: 4px; }
QMenu::item { padding: 6px 28px 6px 12px; border-radius: 6px; }
QMenu::separator { height: 1px; margin: 4px 8px; }
/* The sidebar menu's group headings (Workspace, Companion, Studio, Runtime). */
QLabel#sidebarMenuSection { font-size: 12px; font-weight: 600; padding: 6px 12px 2px 12px; }

QScrollBar:vertical { width: 12px; margin: 2px 2px 2px 0; }
QScrollBar:horizontal { height: 12px; margin: 0 2px 2px 2px; }
QScrollBar::handle:vertical { border-radius: 4px; min-height: 32px; margin: 0 2px; }
QScrollBar::handle:horizontal { border-radius: 4px; min-width: 32px; margin: 2px 0; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0px; height: 0px; }

QScrollArea { border: none; }
/* The scrolled page must not paint its own slab over the page background. */
QScrollArea > QWidget > QWidget { background: transparent; }
QSplitter::handle { width: 1px; height: 1px; }

/* ---------------------------------------------------------------- status popover chips */

QLabel#affectLabel, QLabel#speechLabel, QLabel#microphoneLabel,
QLabel#automationLabel, QLabel#visionLabel, QLabel#perceptionLabel {
    border: 1px solid;
    border-radius: 6px;
    padding: 7px 10px;
    font-size: 12px;
}
QLabel#perceptionLabel[watching="true"] { font-weight: 600; }

/* ---------------------------------------------------------------- shell: sidebar */

QWidget#rootPanel { border: none; }
QWidget#navigationSidebar { border: none; border-right: 1px solid; }
QWidget#sidebarHeader, QWidget#sidebarBody, QWidget#sidebarFooter { border: none; }
QWidget#sidebarFooter { border-top: 1px solid; }
QLabel#sidebarBrand { font-size: 15px; font-weight: 600; }
QLabel#sidebarBrandMark { font-size: 15px; font-weight: 600; }
/* ShellSidebar sets every size here (32px header and footer buttons, 40px rail targets, a 44px
   account button). No rule may set a minimum size: the polish would put it over those, and the
   first layout would differ from the one after a collapse and expand. An 18px icon with 6px
   padding and the 1px border fills 32px exactly. */
QWidget#navigationSidebar QToolButton { padding: 6px; font-size: 13px; }
QWidget#navigationSidebar QToolButton:focus { padding: 5px; }
/* A line edit's search and clear icons are tool buttons too. */
QWidget#navigationSidebar QLineEdit QToolButton { padding: 0; border: none; }
QWidget#navigationSidebar QToolButton#sidebarToggle, QWidget#navigationSidebar QToolButton#sidebarRailNewChat,
QWidget#navigationSidebar QToolButton#sidebarRailSearch, QWidget#navigationSidebar QToolButton#sidebarRailPanels,
QWidget#navigationSidebar QToolButton#sidebarSettingsButton {
    padding: 6px;
}
QWidget#navigationSidebar QToolButton#sidebarMenuButton { padding: 6px 8px; text-align: left; }
QWidget#navigationSidebar QToolButton#sidebarMenuButton:focus { padding: 5px 7px; }
QLabel#sidebarAvatar {
    min-width: 28px; max-width: 28px; min-height: 28px; max-height: 28px;
    border-radius: 14px;
    font-size: 12px;
    font-weight: 600;
}
QLabel#sidebarAccountName { font-size: 13px; font-weight: 600; }
QLabel#sidebarAccountDetail { font-size: 12px; }
QLabel#sidebarAttentionDot { min-width: 8px; max-width: 8px; min-height: 8px; max-height: 8px; border-radius: 4px; }

QWidget#chatSessionsPanel { border: none; }
QLabel#chatSessionsHeading { font-size: 12px; font-weight: 600; padding: 0 2px; }
QLabel#chatSessionsStatus, QLabel#archivedChatLabel { font-size: 12px; }
/* Lined up with the rows' text: the list's 2px padding, the item's 8px and its frame. */
QLabel#chatSessionsStatus { padding: 4px 12px; }
QListWidget#chatSessionList { border: none; border-radius: 6px; padding: 2px; font-size: 13px; }
QListWidget#chatSessionList[kbdFocus="true"]:focus { border-style: solid; border-width: 2px; padding: 0px; }
QListWidget#chatSessionList::item { padding: 6px 8px; border-radius: 6px; }
QPushButton#newChatButton { text-align: left; padding: 6px 8px; font-weight: 400; }
QPushButton#newChatButton:focus { padding: 5px 7px; }
QPushButton#chatSidebarToggle { text-align: left; padding: 4px 8px; font-size: 12px; font-weight: 600; }
QPushButton#chatSidebarToggle:focus { padding: 3px 7px; }
QPushButton#renameChatButton, QPushButton#deleteChatButton, QPushButton#exportChatButton,
QPushButton#backToChatButton {
    padding: 4px 8px;
    font-size: 12px;
}

/* ---------------------------------------------------------------- shell: chat column and header */

QWidget#chatColumn { border: none; }
QWidget#chatHeader { border: none; border-bottom: 1px solid; }
QLabel#chatTitle { font-size: 14px; font-weight: 600; }
QWidget#privacyIndicators { border: none; }
QToolButton#privacyMic, QToolButton#privacyPerception, QToolButton#privacyScreen,
QToolButton#privacyCamera, QToolButton#privacyDesktop {
    padding: 4px;
    border-radius: 6px;
}
QToolButton#privacyMic:focus, QToolButton#privacyPerception:focus, QToolButton#privacyScreen:focus,
QToolButton#privacyCamera:focus, QToolButton#privacyDesktop:focus {
    padding: 3px;
}
QPushButton#headerDesktopStop { padding: 4px 12px; font-size: 12px; }
QPushButton#headerDesktopStop:focus { padding: 3px 11px; }
/* Qt draws square corners for a radius over half the height; the window keeps the pill 28px tall. */
QToolButton#statePill { border-width: 1px; border-radius: 14px; padding: 4px 10px; }
QToolButton#statePill:focus { border-width: 2px; padding: 3px 9px; }
QLabel#stateDot { min-width: 8px; max-width: 8px; min-height: 8px; max-height: 8px; border-radius: 4px; }
QLabel#stateLabel { font-size: 12px; font-weight: 600; }
QLabel#stateDetailLabel { font-size: 12px; }
QToolButton#chatMoreButton { padding: 6px; }
QToolButton#chatMoreButton:focus { padding: 5px; }
QFrame#statusPopover { border: 1px solid; border-radius: 10px; padding: 12px; }

/* The transcript: frameless, with a 1px ring only after a keyboard focus (kbdFocus). */
QTextBrowser#chatHistory { border: 1px solid transparent; border-radius: 0px; padding: 0px; font-size: 15px; }
QTextBrowser#chatHistory:focus { border-width: 1px; padding: 0px; }
QToolButton#jumpToLatest { border: 1px solid; border-radius: 14px; padding: 4px 12px; font-size: 12px; font-weight: 600; }
QToolButton#jumpToLatest:focus { border-width: 2px; padding: 3px 11px; }
QWidget#archivedChatBanner { border: 1px solid; border-radius: 10px; }

/* ---------------------------------------------------------------- shell: composer */

QWidget#composerArea, QWidget#composerShadowHost, QWidget#composerToolbar { border: none; }
QFrame#composerCard { border: 1px solid; border-radius: 20px; padding: 1px; }
QFrame#composerCard[focused="true"], QFrame#composerCard[voice="listening"], QFrame#composerCard[voice="transcribing"] {
    border-width: 2px;
    padding: 0px;
}
QFrame#composerCard QPlainTextEdit { border: none; padding: 0px; font-size: 15px; }
QFrame#composerCard QPlainTextEdit:focus { border: none; padding: 0px; }
/* Icon-only round buttons in the composer toolbar: 32px, never padded out of their circle. */
QWidget#composerToolbar QPushButton {
    border-radius: 16px;
    padding: 0px;
    min-width: 30px; max-width: 30px; min-height: 30px; max-height: 30px;
}
QWidget#composerToolbar QPushButton:focus { padding: 0px; }
QWidget#composerContext { border: none; border-radius: 10px; }
QLabel#composerContextLabel { font-size: 12px; }
QToolButton#composerProfileChip, QToolButton#composerHandsFreeChip {
    border-radius: 14px;
    padding: 4px 10px;
    min-height: 18px;
    font-size: 12px;
    font-weight: 600;
}
QToolButton#composerProfileChip:focus, QToolButton#composerHandsFreeChip:focus { padding: 3px 9px; }

/* The strip above the composer: flat, small, and quiet unless something needs a look. */
QFrame#conversationStatusCard { border: none; }
QLabel#conversationCurrentStatus { font-size: 12px; font-weight: 600; }
QLabel#conversationOwnerOutcome, QLabel#conversationResponseTiming, QLabel#conversationResultEvidence,
QLabel#conversationQualityDiagnostic {
    font-size: 12px;
}

QFrame#chatVoiceHealthCard, QFrame#voiceHealthCard { border: 1px solid; border-radius: 10px; }
QLabel#chatVoiceHealthBadge, QLabel#voiceHealthBadge {
    border: 1px solid;
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 11px;
    font-weight: 600;
}
QLabel#voiceHealthTitle { font-size: 15px; font-weight: 600; }
QLabel#chatVoiceHealthDetail, QLabel#voiceHealthDetail { font-size: 12px; }
QLabel#voiceCueStatus, QLabel#voiceHealthUpdated { font-size: 11px; }

QFrame#attachmentChip { border: 1px solid; border-radius: 10px; }
QLabel#attachmentChipLabel { font-size: 12px; }
QToolButton#attachmentChipRemove { padding: 1px 3px; font-size: 13px; }
QToolButton#attachmentChipRemove:focus { padding: 0px 2px; }
QLabel#attachmentStatus, QLabel#documentsStatus { font-size: 12px; }

/* ---------------------------------------------------------------- shell: overlays, palette, panels */

QFrame#toast { border: none; border-radius: 10px; padding: 8px 14px; }
QLabel#toastLabel { font-size: 13px; }
QLabel#navigationLockOverlay { border: none; font-size: 16px; font-weight: 600; }
QWidget#commandPaletteScrim { border: none; }
QFrame#commandPalette { border: 1px solid; border-radius: 14px; }
QLineEdit#commandPaletteInput {
    border: none;
    border-bottom: 1px solid;
    border-radius: 0px;
    padding: 12px 16px;
    font-size: 16px;
}
/* Widths and style only: a border shorthand without a colour would reset it to black, over the
   divider colour the theme gives the input. */
QLineEdit#commandPaletteInput:focus { border-width: 0px 0px 1px 0px; border-style: solid; padding: 12px 16px; }
QListWidget#commandPaletteList { border: none; border-radius: 0px; padding: 4px; }
QListWidget#commandPaletteList[kbdFocus="true"]:focus { border-style: solid; border-width: 2px; padding: 2px; }
QListWidget#commandPaletteList::item { padding: 0px; border-radius: 6px; }
QLabel#commandPaletteEmpty { padding: 16px; font-size: 13px; }
QLabel#commandPaletteFooter { border-top: 1px solid; padding: 8px 16px; font-size: 12px; }
QWidget#panelHeader { border: none; }
QToolButton#panelPlaceBeside, QToolButton#panelOpenSettings { padding: 6px; }
QToolButton#panelPlaceBeside:focus, QToolButton#panelOpenSettings:focus { padding: 5px; }
QDialog#shortcutsDialog { border: none; }
QTableWidget#shortcutsTable { border-radius: 10px; }
QWidget#microphoneRow { border: none; }
[reviaRole="panelWindow"] { border: none; }

/* ---------------------------------------------------------------- settings dialog */

QDialog#settingsDialog { border: none; }
QWidget#settingsNav { border: none; border-right: 1px solid; }
QLineEdit#settingsSearch { border-radius: 6px; }
QListWidget#settingsSections { border: none; border-radius: 6px; padding: 2px; font-size: 13px; }
QListWidget#settingsSections[kbdFocus="true"]:focus { border-style: solid; border-width: 2px; padding: 0px; }
QListWidget#settingsSections::item { padding: 6px 10px; border-radius: 6px; }
QStackedWidget#settingsStack { border: none; }
[reviaRole="settingsSection"] { border: none; }
QLabel#settingsSectionTitle { font-size: 22px; font-weight: 600; }
QLabel#settingsSectionIntro { font-size: 13px; }
QLabel#settingsGroupTitle { font-size: 13px; font-weight: 600; padding-top: 8px; }
QFrame#settingsGroup { border: 1px solid; border-radius: 10px; }
QFrame#settingsDivider { border: none; min-height: 1px; max-height: 1px; }
QLabel#settingsRiskyHeader { font-size: 12px; font-weight: 600; }
/* Row frames get their 12/16 padding from the dialog's layout, never from here. The
   transparent border is there so the highlight outline does not move the row's content. */
QFrame[reviaClass="settingRow"] { border: 1px solid transparent; border-radius: 6px; }
QLabel#settingTitle { font-size: 13px; font-weight: 600; }
QLabel#settingDescription { font-size: 12px; }
QLabel#settingBadge { border: none; border-radius: 4px; padding: 1px 6px; font-size: 11px; font-weight: 600; }
QLabel#settingWarning, QLabel#settingStatus { font-size: 12px; }
QFrame#settingsRestartBanner { border: 1px solid; border-radius: 10px; padding: 8px 12px; }
QPushButton#settingsRestartNow { padding: 4px 12px; font-size: 12px; }
QPushButton#settingsRestartNow:focus { padding: 3px 11px; }
QLabel#settingsNoResults { padding: 24px; font-size: 13px; }
QMessageBox#settingConfirmDialog { border: none; }
QFrame#themeSegment { border: 1px solid; border-radius: 8px; padding: 2px; }
QPushButton#themeSystem, QPushButton#themeLight, QPushButton#themeDark {
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 4px 12px;
    font-size: 12px;
}
QPushButton#themeSystem:focus, QPushButton#themeLight:focus, QPushButton#themeDark:focus { border-width: 2px; padding: 3px 11px; }
QComboBox#chatTextSizeCombo, QComboBox#cloudUseForCombo { min-width: 140px; }
QDoubleSpinBox#profileTemperatureSpin, QSpinBox#profileMaxTokensSpin { min-width: 96px; }

/* ---------------------------------------------------------------- permissions (CapabilityPanel) */

QFrame#permCard, QFrame#gatedCard { border: 1px solid; border-radius: 10px; }
QFrame#introBar { border: 1px solid; border-left-width: 2px; border-radius: 10px; }
QFrame#iconWell, QFrame#iconWellGated { border: 1px solid; border-radius: 8px; }
QLabel#cardTitle { font-size: 15px; font-weight: 600; }
QLabel#cardSubtitle { font-size: 12px; }
/* A dependent permission is indented under the one it needs, and titled like every other row. */
QLabel#permLabel, QLabel#permLabelNested { font-size: 13px; font-weight: 600; }
QLabel#permHelp, QLabel#permRowHelp { font-size: 12px; }
QFrame#permRow, QFrame#permRowNested { border: none; border-radius: 6px; }
QFrame#rowSeparator { border: none; }
/* Risk is carried by a chip's word as well as its colour, so it survives a colour-blind read. */
QLabel#chipAutonomy, QLabel#chipGated, QLabel#chipCritical {
    border: none;
    border-radius: 4px;
    padding: 2px 7px;
    font-size: 11px;
    font-weight: 600;
}
QLabel#infoDot { border: 1px solid; border-radius: 7px; font-size: 9px; font-weight: 600; }
QLabel#gatedNotice { border: 1px solid; border-radius: 10px; padding: 12px 14px; font-size: 12px; }
QFrame#stopBar { border: 1px solid; border-radius: 10px; }
QLabel#stopState { font-size: 12px; }
QWidget#capabilityListFooter { border: none; border-radius: 10px; }

/* ---------------------------------------------------------------- page text */

QLabel#sectionTitle { font-size: 16px; font-weight: 600; }
QLabel#mindHeadline { font-size: 16px; font-weight: 600; }
QLabel#voiceStudioStatus, QLabel#profileActiveBanner { border: 1px solid; border-radius: 6px; padding: 8px; }
QLabel#profileActiveBanner, QLabel#profileStatus, QLabel#memoryStatus { font-weight: 600; }
QLabel#activityIssueSummary { font-weight: 600; }
QLabel#memoryRevisionProvenance { font-size: 12px; }
