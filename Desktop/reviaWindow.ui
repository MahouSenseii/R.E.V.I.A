          <item row="0" column="0"><widget class="QCheckBox" name="bargeInCheck"><property name="text"><string>Let me interrupt Revia while she speaks</string></property><property name="checked"><bool>true</bool></property></widget></item>
          <item row="0" column="1"><widget class="QCheckBox" name="initiativeCheck"><property name="text"><string>Allow natural conversation starters</string></property><property name="checked"><bool>true</bool></property></widget></item>
          <item row="1" column="0"><widget class="QCheckBox" name="curiosityCheck"><property name="toolTip"><string>Lets Revia privately consider recent conversation or a meaningful emotion. Time alone never creates a topic.</string></property><property name="text"><string>Allow self-directed curiosity</string></property><property name="checked"><bool>true</bool></property></widget></item>
          <item row="1" column="1"><widget class="QCheckBox" name="spontaneousSpeechCheck"><property name="text"><string>Allow admitted thoughts to become speech</string></property><property name="checked"><bool>true</bool></property></widget></item>
          <item row="2" column="0"><widget class="QCheckBox" name="speakWhenAwayCheck"><property name="toolTip"><string>Windows idle state may make an otherwise valid opening eligible; being away never creates the topic.</string></property><property name="text"><string>Allow spontaneous speech while I am away</string></property><property name="checked"><bool>true</bool></property></widget></item>
          <item row="2" column="1"><widget class="QCheckBox" name="aiFilterCheck"><property name="toolTip"><string>Reviews completed replies before they reach speech, memory, or chat history. Turning this off reduces latency; the hard deterministic filter stays on.</string></property><property name="text"><string>AI response review</string></property><property name="checked"><bool>true</bool></property></widget></item>
          <item row="3" column="0"><widget class="QLabel" name="initiativeMaxLabel"><property name="text"><string>Maximum spontaneous lines per hour</string></property></widget></item>
          <item row="3" column="1"><widget class="QSpinBox" name="initiativeMaxSpin"><property name="minimum"><number>1</number></property><property name="maximum"><number>30</number></property><property name="value"><number>4</number></property></widget></item>
          <item row="4" column="0" colspan="2"><widget class="QLabel" name="hardFilterStatus"><property name="text"><string>Hard safety + grounding filter: always on</string></property></widget></item>
          <item row="0" column="2" rowspan="5"><spacer name="conversationBehaviorSpacer"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
         </layout></item>
         <item><widget class="QLabel" name="conversationBehaviorHint"><property name="text"><string>Curiosity can mature from unresolved dialogue or a meaningful emotion, but an empty timer tick stays silent. Every spontaneous line still passes the attention, cooldown, and hourly-budget gates. Autonomous web research has its own permission under Permissions.</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
        </layout></widget></item>
        <item><widget class="QGroupBox" name="diagnosticsGroup"><property name="title"><string>Diagnostics</string></property><layout class="QHBoxLayout" name="diagnosticsLayout">
         <item><widget class="QLabel" name="resourceSampleLabel"><property name="text"><string>Sample CPU, RAM, and GPU every</string></property></widget></item>
         <item><widget class="QSpinBox" name="resourceSampleSpin"><property name="minimum"><number>0</number></property><property name="maximum"><number>3600</number></property><property name="specialValueText"><string>Off</string></property><property name="suffix"><string> seconds</string></property><property name="value"><number>2</number></property></widget></item>
         <item><widget class="QLabel" name="preferenceStatus"><property name="text"><string>Settings are ready.</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
         <item><spacer name="diagnosticsSpacer"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
        </layout></widget></item>
        <item><spacer name="settingsSpacer"><property name="orientation"><enum>Qt::Vertical</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>40</height></size></property></spacer></item>
       </layout>
      </widget>
     </widget>
    </item>
   </layout>
