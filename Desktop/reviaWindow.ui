        <item><widget class="QLabel" name="presenceIntro"><property name="text"><string>One coordination layer keeps listening, conversational momentum, avatar output, and bounded external conversations in sync. It does not own model inference or application permissions.</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
