# Render supplies PORT. Local copies with real digests must remain untracked.
NODE_ENV=production
REVIA_WEB_BIND=0.0.0.0
REVIA_WEB_HOST_ID=revia-public
REVIA_WEB_ORIGINS=https://mahousenseii.github.io
# SHA-256 digests of your independent random host credential and invite code.
REVIA_WEB_HOST_TOKEN_SHA256=
REVIA_WEB_INVITE_SHA256=
# Leave proxy trust unset until Render verifies ingress peers for your service.
# Never use outbound IP ranges or a guessed private network here.
