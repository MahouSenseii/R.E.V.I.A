# Copy to .env.bridge locally. Do not upload this file to Render.
NODE_ENV=production
REVIA_WEB_HOST_ID=revia-public
# Replace with the ACTUAL deployed relay host. This placeholder cannot connect.
REVIA_WEB_RELAY_URL=wss://replace-me.invalid/v1/host
REVIA_WEB_HOST_TOKEN=
# WebDemo.ps1 loads the shared local token and port from .env.revia.
# For standalone bridge/main.js, also load .env.revia with --env-file.
# REVIA_WEB_LOCAL_URL=http://127.0.0.1:17864
