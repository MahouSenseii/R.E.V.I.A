# Copy locally to .env; never commit the copy. Node does not load this automatically.
# Prefer the separate .env.relay.example, .env.bridge.example and .env.revia.example
# templates and the private config directory described in WINDOWS.md.
# Relay: Node --env-file=.env relay/main.js [--check]
NODE_ENV=production
PORT=8787
REVIA_WEB_BIND=0.0.0.0
REVIA_WEB_HOST_ID=revia-public
REVIA_WEB_ORIGINS=https://mahousenseii.github.io
# Only verified ingress peer ranges; leave unset until confirmed. Never use /0.
# REVIA_WEB_TRUSTED_PROXY_CIDRS=127.0.0.1/32
REVIA_WEB_HOST_TOKEN_SHA256=replace-with-64-lowercase-hex-sha256-digest
REVIA_WEB_INVITE_SHA256=replace-with-64-lowercase-hex-sha256-digest
# Optional JSON object of LOWER operating limits; see README for hard ceilings.
# REVIA_WEB_LIMITS={"dailyCap":100,"maxSessions":5}

# Connector only: use a SEPARATE local environment file, not relay storage.
# REVIA_WEB_RELAY_URL=wss://your-relay.onrender.com/v1/host
# REVIA_WEB_HOST_TOKEN=replace-with-random-host-secret-at-least-32-bytes
# REVIA_WEB_LOCAL_TOKEN=replace-with-different-random-local-secret-at-least-32-bytes
# REVIA_WEB_LOCAL_URL=http://127.0.0.1:17864
